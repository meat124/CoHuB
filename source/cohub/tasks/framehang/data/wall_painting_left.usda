#usda 1.0
(
    customLayerData = {
        string modifiedFor = "CoHuB: movable wall painting for the FrameHang task"
    }
    defaultPrim = "WallPainting"
    doc = "One of the gallery's own pictures for CoHuB's FrameHang task: Poly Haven's fancy_picture_frame_02 (CC0) wrapped in a kinematic rigid body so the reset can move it with the wall it hangs on, with the scan's stock canvas hidden and vermeer girl with a pearl earring drawn in its place (portrait moulding, so a portrait painting). Visual only -- no collider; nothing in this task goes near it. GENERATED by tools/assets/build_wall_paintings.py -- do not edit by hand."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WallPainting" (
    apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "ArtworkOverlay"
        {
            token outputs:surface.connect = </WallPainting/Looks/ArtworkOverlay/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </WallPainting/Looks/ArtworkOverlay/Texture.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 0.62
                float inputs:opacity = 1.0
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./gallery_art/vermeer_girl_with_a_pearl_earring.jpg@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float2 inputs:st.connect = </WallPainting/Looks/ArtworkOverlay/STReader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "STReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Backing"
        {
            token outputs:surface.connect = </WallPainting/Looks/Backing/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.055, 0.05)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Xform "picture" (
        prepend references = @./polyhaven/fancy_picture_frame_02/fancy_picture_frame_02_1k.usdc@
    )
    {
        # The scan's own canvas is hidden and the painting below is drawn in
        # its place, on the same plane and to the same extents plus a lip.
        over "fancy_picture_frame_02_canvas"
        {
            token visibility = "invisible"
        }
    }

    # The painting. Its edges run under the moulding rather than butting
    # against it, so there is no join to find from any angle.
    def Mesh "ArtworkOverlay" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [
            (-0.198648, -0.009327, -0.256567),
            (0.198695, -0.009327, -0.256567),
            (0.198695, -0.009327, 0.248275),
            (-0.198648, -0.009327, 0.248275)
        ]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </WallPainting/Looks/ArtworkOverlay>
    }

    # The scan is a shell, so the back of the canvas is a hole with the inside
    # of the moulding visible through it. This closes it.
    def Cube "ArtworkBacking" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (0.199202, 0.001, 0.252951)
        double3 xformOp:translate = (0.000023, -0.007222, -0.004146)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </WallPainting/Looks/Backing>
    }
}
