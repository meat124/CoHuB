#usda 1.0
(
    customLayerData = {
        string modifiedFor = "CoHuB: a gallery canvas for the FrameHang task"
    }
    defaultPrim = "Canvas"
    doc = "A gallery canvas for CoHuB's FrameHang task: turner fighting temeraire on a 2.53 x 1.30 m stretcher, kinematic so a wall that moves can carry it. Hung where scene_136's own gallery_painting_0 was -- that one is a soft generated ink wash whose atlas cannot be repainted (fragmented faceVarying UVs), so it is hidden and this replaces it. GENERATED by tools/assets/build_wall_paintings.py -- do not edit by hand."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Canvas" (
    apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Art"
        {
            token outputs:surface.connect = </Canvas/Looks/Art/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Canvas/Looks/Art/Texture.outputs:rgb>
                float inputs:metallic = 0.0
                float inputs:roughness = 0.62
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./gallery_art/turner_fighting_temeraire.jpg@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float2 inputs:st.connect = </Canvas/Looks/Art/STReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "STReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "Stretcher"
        {
            token outputs:surface.connect = </Canvas/Looks/Stretcher/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.040, 0.035)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
    }

    # The stretcher: a slab the painting is stretched over, standing off the
    # wall.  Its face is at y = -0.045 and the quad sits a hair in front.
    # The origin is the canvas's centre, so a slot's measured centre height is
    # what goes in the cfg.
    def Cube "Stretcher" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (1.265000, 0.022500, 0.650000)
        double3 xformOp:translate = (0, -0.022500, 0.000000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Canvas/Looks/Stretcher>
    }

    # The painting.  -Y is the room side, the same convention the task's own
    # wall pictures use, so a slot on another wall is a yaw and nothing else.
    def Mesh "Art" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        point3f[] points = [
            (-1.230000, -0.045500, -0.615000),
            (1.230000, -0.045500, -0.615000),
            (1.230000, -0.045500, 0.615000),
            (-1.230000, -0.045500, 0.615000)
        ]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Canvas/Looks/Art>
    }
}
