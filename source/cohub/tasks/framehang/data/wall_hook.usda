#usda 1.0
(
    customLayerData = {
        string modifiedFor = "CoHuB: gallery wall peg for the FrameHang task"
    }
    defaultPrim = "WallHook"
    doc = "The wall peg for CoHuB's FrameHang task, and deliberately a big one: it is the single thing both operators aim at. The room is the -Y side of the wall, so the 0.15 m shank runs from the wall face toward -Y, with a groove turned in it 0.09 m out for the picture's loop to settle into and a knob on the end to stop the loop running off. Collision is the whole peg; the mounting plate is visual only and stands 10 mm proud of the wall so its face never shares the plaster's plane. GENERATED by scripts/build_framehang_assets.py from geometry.py; the plate offset was applied by hand (HOOK_PLATE_PROUD)."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WallHook" (
    apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    # A *kinematic* rigid body rather than a static prim, because the reset
    # draws the peg somewhere new every episode and only a rigid body can be
    # written to.  Authored here rather than left to Isaac Lab's spawner:
    # ``modify_rigid_body_properties`` only touches prims that already carry
    # the schema, so without this the RigidObject binding finds no body at all.
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Bronze"
        {
            token outputs:surface.connect = </WallHook/Looks/Bronze/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.2, 0.16)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }

    }

    # The peg, in three turned lengths: wall to groove, the groove itself, and
    # the bare end the operator still sees once the picture is on.
    def Cylinder "shank_inner" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.064007
        double radius = 0.014
        rel material:binding = </WallHook/Looks/Bronze>
        double3 xformOp:translate = (0, -0.032003, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "groove" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.051987
        double radius = 0.008
        rel material:binding = </WallHook/Looks/Bronze>
        double3 xformOp:translate = (0, -0.09, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "shank_outer" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.034007
        double radius = 0.014
        rel material:binding = </WallHook/Looks/Bronze>
        double3 xformOp:translate = (0, -0.132997, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # The knob: bigger than the shank so it is a stop, smaller than half the
    # loop's opening so the loop still threads over it.
    def Sphere "knob" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        double radius = 0.017
        rel material:binding = </WallHook/Looks/Bronze>
        double3 xformOp:translate = (0, -0.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # The mounting plate stands 10 mm proud of the plaster (HOOK_PLATE_PROUD in
    # geometry.py).  It used to sit flush -- its front face on the wall's own
    # face -- and two faces on one plane z-fight, so the square flickered in
    # every render.  The back 6 mm stays inside the wall, so there is no seam.
    def Cube "plate" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (0.045, 0.008, 0.045)
        double3 xformOp:translate = (0, -0.002, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </WallHook/Looks/Bronze>
    }
}
