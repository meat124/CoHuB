#usda 1.0
(
    defaultPrim = "Ceiling"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ceiling"
{
    def Scope "Looks"
    {
        def Material "CeilingMaterial"
        {
            token outputs:surface.connect = </Ceiling/Looks/CeilingMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.89)
                color3f inputs:emissiveColor = (0.1, 0.1, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Cube "Slab" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Ceiling/Looks/CeilingMaterial>
        bool primvars:doNotCastShadows = 1
        bool primvars:invisibleToSecondaryRays = 1
        double size = 1
    }
}

