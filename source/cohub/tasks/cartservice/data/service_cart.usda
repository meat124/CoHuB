#usda 1.0
(
    defaultPrim = "ServiceCart"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ServiceCart" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 0
    float physics:mass = 12
    bool physics:rigidBodyEnabled = 1

    def Scope "Looks"
    {
        def Material "SteelMaterial"
        {
            token outputs:surface.connect = </ServiceCart/Looks/SteelMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "TimberMaterial"
        {
            token outputs:surface.connect = </ServiceCart/Looks/TimberMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.12, 0.07)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "RubberMaterial"
        {
            token outputs:surface.connect = </ServiceCart/Looks/RubberMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "GripPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "CasterPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.05
            float physics:restitution = 0
            float physics:staticFriction = 0.05
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

