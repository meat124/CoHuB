    {
        float3[] extent = [(-0.038, -0.038, -0.038), (0.038, 0.038, 0.038)]
        rel material:binding = </ServiceCart/Looks/RubberMaterial>
        rel material:binding:physics = </ServiceCart/Looks/CasterPhysics> (
